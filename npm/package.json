{
  "name": "@qualflare/cli",
  "version": "0.0.0",
  "description": "Qualflare CLI (qf) — upload test results to Qualflare from any CI or local machine. Ships the platform-native binary as an optional dependency; no install scripts.",
  "keywords": [
    "qualflare",
    "test",
    "testing",
    "ci",
    "test-results",
    "flaky-tests",
    "test-reporting",
    "cli"
  ],
  "homepage": "https://qualflare.com",
  "bugs": {
    "url": "https://github.com/Qualflare/qualflare-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Qualflare/qualflare-cli.git",
    "directory": "npm"
  },
  "license": "Apache-2.0",
  "author": "Qualflare",
  "bin": {
    "qf": "bin/qf"
  },
  "files": [
    "bin/qf",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=16"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "optionalDependencies": {
    "@qualflare/cli-darwin-arm64": "0.0.0",
    "@qualflare/cli-darwin-x64": "0.0.0",
    "@qualflare/cli-linux-arm64": "0.0.0",
    "@qualflare/cli-linux-x64": "0.0.0",
    "@qualflare/cli-win32-arm64": "0.0.0",
    "@qualflare/cli-win32-x64": "0.0.0"
  }
}
