# Build artifacts
build/
bin/
dist/
*.exe
*.exe~
*.dll
*.so
*.dylib

# The npm wrapper's launcher is tracked (bin/ above would otherwise ignore it).
# Nothing else lands here — the platform binaries ship in the @qualflare/cli-<os>-<arch>
# packages, which scripts/build-npm-packages.mjs assembles under dist/.
!npm/bin/
npm/bin/*
!npm/bin/qf

