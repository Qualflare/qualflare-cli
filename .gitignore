coverage.out
coverage.html
*.test

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Internal
.planning/

# Environment
.env
.env.local

# AI assistant config
CLAUDE.md
